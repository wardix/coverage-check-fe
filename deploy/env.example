# Config deploy per environment untuk deploy/deploy-static.sh.
# Salin lalu isi:  cp deploy/env.example deploy/prod.env
# File deploy/*.env tidak di-commit (lihat .gitignore).

# Server nginx tujuan. Kosongkan DEPLOY_HOST kalau script dijalankan langsung
# di server nginx itu sendiri (build dan deploy di mesin yang sama).
DEPLOY_HOST=server.nusa.net.id
DEPLOY_USER=deploy
DEPLOY_PORT=22
# Opsi ssh tambahan, contoh: "-i ~/.ssh/id_deploy"
# Satu deploy membuka 3 koneksi ssh. Kalau key pakai passphrase tanpa ssh-agent,
# pakai multiplexing supaya cukup sekali login (tidak didukung OpenSSH Windows):
# DEPLOY_SSH_OPTS="-o ControlMaster=auto -o ControlPath=~/.ssh/cm-%C -o ControlPersist=60"
DEPLOY_SSH_OPTS=""

# Folder app di server. Script membuat releases/ dan symlink current di sini.
# Di nginx:  root <DEPLOY_PATH>/current;
DEPLOY_PATH=/var/www/coverage-check-fe

# Deploy hanya boleh dari branch ini (kosongkan untuk bebas). --force untuk melewati.
DEPLOY_BRANCH=main
# 1 = git pull --ff-only sebelum build (berguna kalau build di server).
GIT_PULL=0

# Jumlah release yang disimpan untuk rollback.
KEEP_RELEASES=5

# URL yang dicek dengan curl setelah deploy (opsional).
DEPLOY_URL=

# Override default kalau perlu.
# INSTALL_CMD="npm ci"          # default: deteksi dari lockfile
# BUILD_CMD="npm run build"
# OUT_DIR=out                   # Next.js: out, Vite: dist

# Env build-time (NEXT_PUBLIC_* untuk Next.js, VITE_* untuk Vite) dibakukan ke
# file JS saat build. Taruh nilai environment ini di sini: variabel di file ini
# ikut ter-export ke proses build dan menimpa .env, .env.local, .env.production
# yang ada di mesin build.
# WAJIB diisi untuk build server: default di kode adalah http://localhost:3000/api.
# Jangan dibiarkan kosong tanpa '#': nilai kosong ikut ter-export dan menimpa .env.
# NEXT_PUBLIC_API_URL=https://cc.example.nusa.net.id/api
