# Config deploy untuk deploy/deploy-static.sh. File config ini OPSIONAL:
# tanpa file, `npm run deploy` di server langsung jalan dengan nilai default
# yang tertulis di bawah.
#
# Kalau perlu mengubah default, salin lalu buka komentar baris yang diubah:
#   cp deploy/env.example deploy/default.env   # dipakai: npm run deploy
#   cp deploy/env.example deploy/prod.env      # dipakai: npm run deploy -- prod
# File deploy/*.env tidak di-commit (lihat .gitignore). Baris yang masih
# di-comment atau dibiarkan kosong memakai nilai default.

# Folder yang di-serve nginx. Script membuat releases/ dan symlink current di sini.
# Di nginx:  root <DEPLOY_PATH>/current;
# Default: /var/www/<nama-folder-repo>. Kalau repo sendiri di-clone di path itu,
# default-nya jadi /var/www/<nama-folder-repo>-static. Harus di luar folder repo.
# DEPLOY_PATH=/var/www/coverage-check-fe

# Deploy hanya boleh dari branch ini. Default: kosong (branch apa saja).
# --force untuk melewati.
# DEPLOY_BRANCH=main
# 1 = git pull --ff-only sebelum build. Default: 0.
# GIT_PULL=1

# Jumlah release yang disimpan untuk rollback. Default: 5.
# KEEP_RELEASES=5

# URL yang dicek dengan curl setelah deploy. Default: kosong (tidak dicek).
# DEPLOY_URL=https://<domain-app>/

# Override perintah build kalau perlu.
# INSTALL_CMD="npm ci"          # default: deteksi dari lockfile
# BUILD_CMD="npm run build"     # default
# OUT_DIR=out                   # default: dist untuk Vite (vite.config.*), selain itu out

# Env build-time (NEXT_PUBLIC_* untuk Next.js, VITE_* untuk Vite) dibakukan ke
# file JS saat build. Tanpa nilai di sini, build membaca .env, .env.production,
# dan .env.local di folder repo. Nilai di file ini menimpa nilai di file-file itu.
# Jangan dibiarkan kosong tanpa '#': nilai kosong ikut ter-export dan menimpa .env.
# WAJIB diisi untuk build server: default di kode adalah http://localhost:3000/api.
# NEXT_PUBLIC_API_URL=https://cc.example.nusa.net.id/api

# ---------------------------------------------------------------------------
# Opsional: build di mesin ini, lalu kirim ke server nginx lain lewat SSH.
# Default: DEPLOY_HOST kosong = deploy ke folder di mesin yang menjalankan script.
# Kalau DEPLOY_HOST diisi, DEPLOY_PATH wajib diisi.
# ---------------------------------------------------------------------------
# DEPLOY_HOST=server.nusa.net.id
# DEPLOY_USER=deploy
# DEPLOY_PORT=22
# Opsi ssh tambahan, contoh: "-i ~/.ssh/id_deploy"
# Satu deploy membuka 3 koneksi ssh. Kalau key pakai passphrase tanpa ssh-agent,
# pakai multiplexing supaya cukup sekali login (tidak didukung OpenSSH Windows):
# DEPLOY_SSH_OPTS="-o ControlMaster=auto -o ControlPath=~/.ssh/cm-%C -o ControlPersist=60"
